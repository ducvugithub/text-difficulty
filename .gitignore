.DS_Store
# raw data stays local (vocab list is >100MB, GitHub's per-file limit)
data/
# large generated artifacts
**/outputs/*
!**/outputs/.gitkeep
curated_features/categories/vocab/signals/*/outputs/*
!curated_features/categories/vocab/signals/*/outputs/.gitkeep
curated_features/categories/vocab/signals/vocab_freq/cleaned/*
!curated_features/categories/vocab/signals/vocab_freq/cleaned/.gitkeep
.venv/
__pycache__/
